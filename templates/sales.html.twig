{% extends 'base.html.twig' %}
{% set active = 'sales' %}

{% block title %}Ventes · GestPrimes{% endblock %}
{% block heading %}{{ is_granted('ROLE_SUPERVISEUR') ? 'Ventes' : 'Mes ventes' }}{% endblock %}
{% block subtitle %}Liste des ventes et primes calculées par barème{% endblock %}

{% block body %}
{% if not is_granted('ROLE_SUPERVISEUR') %}
    <div class="toolbar"><a href="{{ path('app_sale_new') }}" class="btn btn-primary">+ Nouvelle vente</a></div>
{% endif %}

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                {% if is_granted('ROLE_SUPERVISEUR') %}<th>Agent</th>{% endif %}
                <th>N° commande</th>
                <th>Type</th>
                <th>Offre</th>
                <th class="num">Valeur</th>
                <th class="num">Prime</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for s in sales %}
                <tr>
                    <td>{{ s.date ? s.date|date('d/m/Y') : '—' }}</td>
                    {% if is_granted('ROLE_SUPERVISEUR') %}<td>{{ s.agent ? s.agent.email|display_name : '—' }}</td>{% endif %}
                    <td class="mono">{{ s.nCommande }}</td>
                    <td>{{ s.type }}</td>
                    <td>{{ s.offre }}</td>
                    <td class="num mono">{{ s.valeur|eur }} €</td>
                    <td class="num mono accent">{{ s.prime is not null ? s.prime|eur ~ ' €' : '—' }}</td>
                    <td><span class="badge badge-{{ s.statut|lower }}">{{ s.statut }}</span></td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="empty">Aucune vente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
