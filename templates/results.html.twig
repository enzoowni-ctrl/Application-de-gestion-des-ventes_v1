{% extends 'base.html.twig' %}
{% set active = 'results' %}

{% block title %}Résultats & primes · GestPrimes{% endblock %}
{% block heading %}Résultats &amp; primes{% endblock %}
{% block subtitle %}CA, primes, heures travaillées et objectif CA/h par agent{% endblock %}

{% block body %}
<form method="get" class="toolbar">
    <input type="month" name="periode" value="{{ periode }}" onchange="this.form.submit()">
    {% if can_edit %}<span class="hint">Saisissez les heures — l'objectif CA/h se calcule en direct.</span>{% endif %}
</form>

<div class="table-wrap">
    <table class="table" id="results-table">
        <thead>
            <tr>
                <th>Agent</th>
                <th class="num">Ventes nettes</th>
                <th class="num">CA (€)</th>
                <th class="num">Primes (€)</th>
                <th class="num">Heures</th>
                <th class="num">Objectif CA/h</th>
            </tr>
        </thead>
        <tbody>
            {% for r in rows %}
                <tr data-ca="{{ r.ca }}">
                    <td class="strong">{{ r.agent.email|display_name }}</td>
                    <td class="num mono">{{ r.ventes }}</td>
                    <td class="num mono">{{ r.ca|eur }} €</td>
                    <td class="num mono accent">{{ r.primes|eur }} €</td>
                    <td class="num">
                        {% if can_edit %}
                            <form method="post" action="{{ path('app_hours_save') }}" class="hours-form inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('hours_save') }}">
                                <input type="hidden" name="agent" value="{{ r.agent.id }}">
                                <input type="hidden" name="periode" value="{{ periode }}">
                                <input type="number" name="heures" class="hours-input" min="0" step="0.5" value="{{ r.heures > 0 ? r.heures : '' }}" data-saved="{{ r.heures }}">
                                <button type="submit" class="btn-icon" title="Enregistrer">✓</button>
                            </form>
                        {% else %}
                            <span class="mono">{{ r.heures|eur }}</span>
                        {% endif %}
                    </td>
                    <td class="num mono strong objectif">{{ r.caParHeure is not null ? r.caParHeure|eur ~ ' €/h' : '—' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="empty">Aucun agent.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
